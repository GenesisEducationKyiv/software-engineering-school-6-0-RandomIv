NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql://postgres:postgres@localhost:5434/github_notifier

API_KEY=local-dev-api-key

RELEASE_CHECK_CRON=*/5 * * * *

REDIS_URL=redis://localhost:6379
GITHUB_CACHE_TTL_SECONDS=600
GITHUB_TOKEN=

GRPC_HOST=0.0.0.0
GRPC_PORT=50051

RABBITMQ_URL=amqp://localhost:5672

# Kept for reference (not used when MQ transport is active)
# NOTIFICATION_URL=http://localhost:3001

# Used only by the notification microservice (src/notification.ts)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
# Uncomment for custom SMTP (defaults to Gmail service)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
NOTIFICATION_PORT=3001
