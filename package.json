{
  "name": "github-release-notifier",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --watch --import tsx src/index.ts",
    "dev:notification": "node --watch --import tsx src/notification.ts",
    "lint": "eslint .",
    "arch:check": "depcruise --config .dependency-cruiser.cjs --output-type err src",
    "arch:graph": "depcruise --config .dependency-cruiser.cjs --output-type mermaid src > docs/architecture-graph.mmd",
    "proto:lint": "buf lint",
    "proto:generate": "buf generate",
    "build": "tsc",
    "db:generate": "node -e \"process.env.DATABASE_URL = process.env.DATABASE_URL || 'postgresql://fake:fake@localhost:5432/fake'; require('node:child_process').execSync('prisma generate', { stdio: 'inherit' });\"",
    "db:migrate:deploy": "prisma migrate deploy",
    "test": "npm run test:unit",
    "test:unit": "jest --config jest.config.cjs --runInBand",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:integration:up": "docker compose -f docker-compose.integration.yml up -d --wait",
    "test:integration:down": "docker compose -f docker-compose.integration.yml down -v",
    "test:integration:run": "jest --config jest.integration.config.cjs --runInBand",
    "test:integration:env": "npm run test:integration:up && npm run test:integration:run; EXIT=$?; npm run test:integration:down; exit $EXIT",
    "test:e2e:up": "docker compose -f docker-compose.e2e.yml up -d --build --wait",
    "test:e2e:down": "docker compose -f docker-compose.e2e.yml down -v",
    "test:e2e:run": "playwright test",
    "test:e2e:env": "npm run test:e2e:up && docker compose -f docker-compose.e2e.yml exec -T notifier-app npx prisma migrate deploy && npm run test:e2e:run; EXIT=$?; npm run test:e2e:down; exit $EXIT",
    "test:all": "npm run test:unit && npm run test:integration:env && npm run test:e2e:env"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com-personal:RandomIv/github-release-notifier.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "amqplib": "^2.0.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.7.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.54.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/amqplib": "^0.10.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.5.2",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "autocannon": "^8.0.0",
    "dependency-cruiser": "^18.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "jest-mock-extended": "^4.0.1",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-proto": "^2.6.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.1"
  }
}
